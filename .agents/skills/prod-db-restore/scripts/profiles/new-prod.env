# Restore target: NEW PRODUCTION (51.255.38.227, OVH VPS). LIVE since the 2026-11-20 cutover (.rules section 14):
# swap/rollback/drop here replace real production data, never run them without explicit owner approval.
# Postgres runs as the Kamal accessory container kw-app-postgres (booted 2026-11-18, see docs/NEW_PRODUCTION_PLAN.md P5.1).
SSH_TARGET=deploy@51.255.38.227
PG_CONTAINER=kw-app-postgres
PG_USER=production_user
LIVE_DB=kw_app_production
# Kamal names the web container kw-app-web-<version>. Until the first deploy (P7) there is none: WEB_OPTIONAL=1
# accepts that; if exactly one is running it is used (stopped/started around swap), more than one is an error.
WEB_FILTER=kw-app-web
WEB_OPTIONAL=1
# config/database.yml has no env override for the production DB name, so the `migrate` rehearsal
# is not available here; rely on db:prepare at boot (the image entrypoint runs it).
DB_NAME_ENV=
MAIL_GATE=1
