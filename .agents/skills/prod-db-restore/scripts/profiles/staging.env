# Restore target: STAGING (Raspberry Pi, Kamal + Docker). Tested 2026-11-17.
SSH_TARGET=rege@pi5main.local
PG_CONTAINER=kw-app-staging-postgres
PG_USER=staging_user
LIVE_DB=kw_app_staging
# docker name filter that matches exactly ONE running web container
WEB_FILTER=kw-app-staging-web
# env var the web image's config/database.yml reads to pick the DB (used to rehearse migrations on a scratch DB)
DB_NAME_ENV=STAGING_DATABASE_NAME
# Staging runs real Mailgun credentials. A 1:1 prod copy contains real member e-mails.
MAIL_GATE=1
