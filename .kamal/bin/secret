#!/usr/bin/env bash
# Resolve ONE deploy secret for Kamal. Usage: .kamal/bin/secret ENV_NAME BWS_SECRET_UUID
#
# 1. If ENV_NAME is already exported and non-empty, print it (CI does this).
# 2. Otherwise fetch exactly that one secret from Bitwarden Secrets Manager by UUID
#    (needs `bws`, `jq` and BWS_ACCESS_TOKEN). Fetching by UUID keeps working if the
#    secret is renamed, and never pulls the other apps' secrets that share the project.
#
# Prints the value with no trailing newline. Never prints anything else to stdout.
# Exits non-zero (loudly, on stderr) when the value cannot be resolved.
set -euo pipefail

name="${1:?usage: secret ENV_NAME BWS_SECRET_UUID}"
id="${2:?usage: secret ENV_NAME BWS_SECRET_UUID}"

if [ -n "${!name:-}" ]; then
  printf '%s' "${!name}"
  exit 0
fi

fail() { echo "kamal secret ${name}: $1" >&2; exit 1; }

command -v bws >/dev/null || fail "not exported and 'bws' is not installed (brew install bitwarden/sm/bws)"
command -v jq  >/dev/null || fail "not exported and 'jq' is not installed"
[ -n "${BWS_ACCESS_TOKEN:-}" ] || fail "not exported and BWS_ACCESS_TOKEN is not set"

value="$(bws secret get "$id" 2>/dev/null | jq -j '.value // empty')" || true
[ -n "$value" ] || fail "bws returned no value for ${id}"
printf '%s' "$value"
