#!/usr/bin/env bash
# Pre-connect hook: Runs before Kamal deployment commands
# This is intentionally minimal - secrets are resolved by .kamal/bin/secret
# (exported env vars from GitHub Actions win, otherwise fetched from bws by UUID)

set -e

# Skip in CI/CD - GitHub Actions handles everything
if [ -n "$CI" ] || [ -n "$GITHUB_ACTIONS" ]; then
  exit 0
fi

# Local deployments: secrets are resolved by .kamal/secrets-common + .kamal/secrets.<dest>
# via .kamal/bin/secret (needs BWS_ACCESS_TOKEN, bws and jq). See .agents/skills/bws-secrets.

exit 0