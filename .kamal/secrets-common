# Kamal secrets shared by every destination (read before .kamal/secrets.<destination>).
# Each value is resolved by .kamal/bin/secret: an exported env var wins (CI), otherwise it
# is fetched from Bitwarden Secrets Manager by UUID. See .agents/skills/bws-secrets/SKILL.md.
# The UUIDs are identifiers, not secrets.

# Docker registry (bws: registry-username / registry-password, shared with other apps)
KAMAL_REGISTRY_USERNAME=$(.kamal/bin/secret KAMAL_REGISTRY_USERNAME 6e77be63-a052-4594-9585-b3da01100ce9)
KAMAL_REGISTRY_PASSWORD=$(.kamal/bin/secret KAMAL_REGISTRY_PASSWORD 6ff8b019-a3e4-4571-85fc-b3da01106838)

# App secrets used by every environment
# bws: kw-app-appsignal-push-api-key / kw-app-strava-verify-token
APPSIGNAL_PUSH_API_KEY=$(.kamal/bin/secret APPSIGNAL_PUSH_API_KEY 10b644fb-ce8b-4d58-b0ac-b5050105f27e)
STRAVA_VERIFY_TOKEN=$(.kamal/bin/secret STRAVA_VERIFY_TOKEN e48a96fa-0e1a-42b9-9393-b505010605a2)
