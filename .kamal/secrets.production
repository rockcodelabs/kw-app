# Kamal secrets for `-d production` (after .kamal/secrets-common).
# bws: kw-app-production-master-key / -postgres-password / -redis-password
RAILS_MASTER_KEY=$(.kamal/bin/secret RAILS_MASTER_KEY 519419f3-6bb7-4ce6-8132-b3da0119bf76)
POSTGRES_PASSWORD=$(.kamal/bin/secret POSTGRES_PASSWORD 9c80203f-f8c2-4b5d-8d4b-b3da0119d394)
REDIS_PASSWORD=$(.kamal/bin/secret REDIS_PASSWORD 8ca74ff6-e6bd-4884-b45b-b3da0119f2a7)
# bws: kw-app-production-mailgun-api-key (Mailgun sending key for kw.krakow.pl; wins over production.yml.enc)
MAILGUN_API_KEY=$(.kamal/bin/secret MAILGUN_API_KEY 811383ff-53d0-4742-b48f-b508016cdc6e)
# bws: kw-app-production-mailgun-webhook-signing-key (Mailgun HTTP webhook signing key; verifies the inbound Route POST to /email_processor)
MAILGUN_WEBHOOK_SIGNING_KEY=$(.kamal/bin/secret MAILGUN_WEBHOOK_SIGNING_KEY 3515b7b9-ee89-471c-8d4e-b5080181ae32)
# bws: kw-app-healthchecks-ping-key (read by the cron role only)
HC_PING_KEY=$(.kamal/bin/secret HC_PING_KEY d37a01b2-04bd-44d1-8f96-b5060154a055)
