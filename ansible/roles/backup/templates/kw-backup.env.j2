# Managed by Ansible (roles/backup). Contains secrets: root only. Never copy this file anywhere.
# Sourced by the kw-backup jobs (see files/kw-backup-lib.sh). Values are single-quoted: Ansible
# refuses to render anything but [A-Za-z0-9+/=_.-], so quoting can never break.
AWS_ACCESS_KEY_ID='{{ backup_secrets.access_key }}'
AWS_SECRET_ACCESS_KEY='{{ backup_secrets.secret_key }}'
AWS_DEFAULT_REGION='{{ backup_s3_region }}'
RESTIC_REPOSITORY='s3:{{ backup_s3_endpoint }}/{{ backup_bucket }}'
RESTIC_PASSWORD='{{ backup_secrets.restic_password }}'
RESTIC_CACHE_DIR='/var/cache/restic'
RESTIC_CHECK_SUBSET='{{ backup_restic_check_subset }}'
HC_PING_KEY='{{ backup_secrets.ping_key }}'
BACKUP_DIR='{{ backup_dir }}'
PG_CONTAINER='{{ backup_pg_container }}'
PG_USER='{{ backup_pg_user }}'
PG_DB='{{ backup_pg_db }}'
RESTORE_DB='{{ backup_restore_scratch_db }}'
KEEP_DAILY='{{ backup_keep_daily }}'
KEEP_WEEKLY='{{ backup_keep_weekly }}'
KEEP_MONTHLY='{{ backup_keep_monthly }}'
