# Managed by Ansible (roles/logs). Contains the healthchecks.io ping key: root only. Never copy this file.
# Sourced by /usr/local/sbin/kw-log-archive. Values are single-quoted: Ansible refuses to render anything but
# [A-Za-z0-9_-] for the key, so quoting can never break.
HC_PING_KEY='{{ logs_secrets.ping_key }}'
KW_HC_SLUG='{{ logs_hc_slug }}'
KW_LOG_DIR='{{ logs_dir }}'
KW_LOG_KEEP_DAYS='{{ logs_keep_days }}'
KW_LOG_SERVICE_LABEL='{{ logs_service_label }}'
KW_LOG_DESTINATION='{{ logs_destination }}'
KW_LOG_FIXED='{% for name, container in logs_fixed_containers.items() %}{{ name }}={{ container }}{{ " " if not loop.last else "" }}{% endfor %}'
KW_LOG_TZ='{{ logs_tz }}'
