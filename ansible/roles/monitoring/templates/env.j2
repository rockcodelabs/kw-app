# Managed by Ansible (roles/monitoring). Contains the healthchecks.io ping key: root only. Never copy this file.
# Sourced by /usr/local/sbin/kw-host-check. Values are single-quoted: Ansible refuses to render anything but
# [A-Za-z0-9_-] for the key, so quoting can never break.
HC_PING_KEY='{{ monitoring_secrets.ping_key }}'
KW_HC_SLUG='{{ monitoring_hc_slug }}'
KW_DISK_PATH='{{ monitoring_disk_path }}'
KW_DISK_MAX_PCT='{{ monitoring_disk_max_pct }}'
KW_INODE_MAX_PCT='{{ monitoring_inode_max_pct }}'
KW_MEM_MIN_AVAILABLE_PCT='{{ monitoring_mem_min_available_pct }}'
KW_SWAP_MAX_PCT='{{ monitoring_swap_max_pct }}'
KW_EXPECTED_CONTAINERS='{{ monitoring_expected_containers | join(" ") }}'
KW_TLS_CHECK_HOST='{{ monitoring_tls_check_host }}'
KW_TLS_ADDR='{{ monitoring_tls_addr }}'
KW_TLS_MIN_DAYS='{{ monitoring_tls_min_days }}'
